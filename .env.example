# 4PM CLI — environment (ADR-0194). Only the knobs an operator needs are listed here;
# copy to `.env` and adjust. The CLI is configured mainly via `4pm link` + the profile's
# config.json — env vars only cover connection, auth injection, and run mode.

# --- Connection ---
# 4PM server base URL. Use an https:// URL in production: the WebSocket session encryption
# does NOT authenticate the server, so TLS is what protects the ws_token + pairing codes.
FOURPM_SERVER=http://localhost:42001

# Pick a specific profile for multi-instance machines (~/.4pm/profiles/<name>/). Optional.
FOURPM_PROFILE=

# --- Auth injection ---
# Headless/container pairing: a provisioning token that self-pairs on boot with no
# interactive hashcode step (ADR-0192 §6). Leave empty for interactive `4pm link`.
FOURPM_PAIR_TOKEN=

# Git credential for clone/push when the server assigns a token-based git-auth method
# (injected out-of-band; never stored by 4PM). Host override is for GHE/self-managed.
FOURPM_GIT_TOKEN=
FOURPM_GIT_HOST=

# Which external AI CLI to drive when the server does not specify one.
AI_CLI=claude

# --- Run mode ---
FOURPM_LOG_LEVEL=info      # error | warn | info | debug
FOURPM_NO_UPDATE=          # set to 1 to disable auto-update on startup
FOURPM_HEADLESS=           # set to 1 to force headless (no interactive TUI) on a TTY

# --- Advanced (rarely needed) ---
# Command-history offload backend + reconnect cap are optional operational knobs; see the
# docs before setting them. Secrets (R2/S3/AWS keys) are read from the environment only,
# never committed.
# HISTORY_STORAGE=
# FOURPM_RECONNECT_MAX_BACKOFF_SEC=
