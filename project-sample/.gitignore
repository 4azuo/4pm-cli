# Claude Code — personal config, do NOT commit
.claude/settings.local.json

# Placeholder secret values (project.secrets.json) — SENSITIVE, do NOT commit.
# AI_PLACEHOLDER.md holds only keys + explanations, so it IS committed (not listed here).
project.secrets.json

# Autonomous workflow — files generated at runtime (lock, per-day tick logs, run history — ADR-0563/0568)
.4pm/.autonomous.lock
.4pm/.autonomous.histories.json
.4pm/logs/

# RAG — engine, runtime, models and index are generated on the worker (not committed; the folder
# also carries its own .gitignore — ADR-0489)
.claude/rag/

# IDE
.vs/

# Test evidence regenerated each run
tests/IT/evidence/*
!tests/IT/evidence/README.md

